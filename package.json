{
  "name": "cobuild-suite",
  "version": "0.6.0-dev.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "config:check": "node tools/config.mjs check config/cobuild.example.json",
    "plan": "node tools/config.mjs plan config/cobuild.example.json",
    "audit": "python3 tools/audit.py",
    "verify": "npm test && npm run config:check && python3 tools/audit.py --check",
    "release:check": "python3 tools/release_check.py",
    "local:init": "node tools/local-init.mjs",
    "local:platform": "node --require ./tools/local-network-guard.cjs tools/serve-platform.mjs",
    "local:recover-owner": "node tools/recover-owner.mjs",
    "test:local-suite": "python3 tools/test_local_suite.py",
    "test:deployment": "python3 tools/test_deployment.py",
    "test:migrations": "python3 tools/test_deployment.py --with-migrations",
    "test:https": "python3 tools/test_deployment.py --https",
    "test:https-browser": "python3 tools/test_deployment.py --https --with-browser",
    "test:deployment-unit": "python3 -m unittest discover -s deploy -p 'test_*.py'"
  }
}
